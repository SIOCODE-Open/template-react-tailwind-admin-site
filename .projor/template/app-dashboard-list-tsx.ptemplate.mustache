{
    "map": {},
    "filename": "src/components/AppDashboardList.component.tsx",
    "formatUsing": "typescript"
}
---
import { Icon } from '@iconify/react';
import classNames from "classnames";

export function AppDashboardList(
    opts: {
        name: string,
        value: Array<string>,
    }
) {
    return <div className="w-full flex flex-col justify-start items-stretch gap-3">
        <p className="text-xl font-bold text-slate-800">{opts.name}</p>
        <div className="flex flex-col justify-start items-stretch gap-0 border border-slate-200 rounded-xl overflow-hidden shadow-sm bg-white">
            {
                opts.value.map((v, i) => {
                    const divClassname = classNames(
                        "w-full flex flex-row justify-start items-center gap-2 px-4 py-3 hover:bg-slate-50 transition-colors duration-150",
                        {
                            "border-b border-slate-200": i !== opts.value.length - 1
                        }
                    )
                    return <div key={i} className={divClassname}>
                        <p className="text-sm text-slate-700">{v}</p>
                    </div>
                })
            }
        </div>
    </div>
}